# ==============================================================================
# Azure Bug Assistant - Environment Configuration
# Copy this file to '.env' and fill in your real values.
# IMPORTANT: Never commit the actual '.env' file containing your credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Azure DevOps Configuration
# ------------------------------------------------------------------------------
# Your Azure DevOps Organization name (e.g., https://dev.azure.com/my-org -> "my-org")
AZURE_DEVOPS_ORG=your-organization-name

# Your Azure DevOps Project name (e.g., "HRMS-Project")
AZURE_DEVOPS_PROJECT=your-project-name

# Azure DevOps Personal Access Token (PAT).
# SECURITY REQUIREMENT:
# Create a PAT in Azure DevOps -> User Settings -> Personal Access Tokens.
# Scope required: "Work Items (Read)" only. DO NOT give Full Access.
AZURE_DEVOPS_PAT=your-azure-devops-pat-token

# ------------------------------------------------------------------------------
# 2. Application & Mode Settings
# ------------------------------------------------------------------------------
# MOCK_MODE: Set to "true" to run with realistic simulated HRMS bug data without
# requiring an active Azure PAT. Set to "false" to connect to real Azure DevOps API.
MOCK_MODE=true

# Host & Port for Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Directory where generated Excel workbooks will be saved
EXCEL_OUTPUT_DIR=./output
EXCEL_FILE_NAME=Azure_Bug_Assistant.xlsx

# SQLite Database for local cache and manual classification overrides
DATABASE_URL=sqlite:///./azure_bugs.db

# ------------------------------------------------------------------------------
# 3. AI Summarization (Optional)
# ------------------------------------------------------------------------------
# SECURITY NOTE:
# Bug titles, repro steps, and descriptions may contain confidential company information.
# Do NOT send sensitive data to an external AI service without explicit company authorization.
# When AI_ENABLED=false (or OPENAI_API_KEY is empty), the application uses an internal,
# privacy-safe rule-based summarization engine that runs entirely locally on your machine.
AI_ENABLED=false
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
